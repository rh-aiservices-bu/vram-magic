# VRAM Magic - Environment Configuration Template
# Copy this file to .env.local for local development
# Update values according to your deployment environment

# =============================================================================
# Application Configuration
# =============================================================================

# Application environment (development, staging, production)
VITE_APP_ENV=development

# Application version (automatically set during build)
VITE_APP_VERSION=0.1.0

# Application title and branding
VITE_APP_TITLE="VRAM Magic"
VITE_APP_DESCRIPTION="GPU memory calculator for LLM deployments"
VITE_APP_KEYWORDS="GPU,VRAM,LLM,memory,calculator,machine learning"

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for API endpoints (if backend integration is added)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# Model data source configuration
VITE_MODELS_BASE_URL=/models
VITE_MODELS_CACHE_TTL=3600000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable specific features
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_ACCESSIBILITY=true
VITE_FEATURE_EXPORT=true
VITE_FEATURE_ADVANCED_CHARTS=true
VITE_FEATURE_MODEL_COMPARISON=false
VITE_FEATURE_CUSTOM_MODELS=false

# Enable development tools
VITE_FEATURE_DEBUG_MODE=false
VITE_FEATURE_PERFORMANCE_MONITORING=false

# =============================================================================
# Analytics and Monitoring
# =============================================================================

# Google Analytics (if analytics integration is added)
VITE_GA_MEASUREMENT_ID=

# Error tracking (Sentry, LogRocket, etc.)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Performance monitoring
VITE_PERFORMANCE_MONITORING=false
VITE_WEB_VITALS_ENDPOINT=

# =============================================================================
# UI Configuration
# =============================================================================

# Theme configuration
VITE_THEME_PRIMARY_COLOR=#1976d2
VITE_THEME_SECONDARY_COLOR=#f57c00
VITE_THEME_DEFAULT_MODE=light

# Chart configuration
VITE_CHART_ANIMATION_DURATION=300
VITE_CHART_RESPONSIVE=true

# =============================================================================
# Build Configuration
# =============================================================================

# Build optimization flags
VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true

# Bundle size limits (in KB)
VITE_BUNDLE_SIZE_LIMIT=1024
VITE_CHUNK_SIZE_LIMIT=500

# =============================================================================
# Security Configuration
# =============================================================================

# Content Security Policy
VITE_CSP_REPORT_URI=
VITE_CSP_STRICT_MODE=false

# HTTPS enforcement
VITE_FORCE_HTTPS=false

# =============================================================================
# Development Configuration
# =============================================================================

# Development server configuration
VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost
VITE_DEV_OPEN=true

# Hot reload and debugging
VITE_DEV_HMR=true
VITE_DEV_OVERLAY=true

# =============================================================================
# Docker Configuration
# =============================================================================

# Container configuration (for docker-compose)
PORT=80
DOMAIN=localhost

# SSL configuration (for production with Traefik)
ACME_EMAIL=admin@example.com

# =============================================================================
# Testing Configuration
# =============================================================================

# Test environment settings
VITE_TEST_TIMEOUT=30000
VITE_TEST_COVERAGE_THRESHOLD=80

# Mock data configuration
VITE_USE_MOCK_DATA=false
VITE_MOCK_API_DELAY=500
