# VRAM Magic - Production Environment Configuration
# Security-focused production settings

# =============================================================================
# Application Configuration
# =============================================================================

VITE_APP_ENV=production
VITE_APP_VERSION=0.1.0
VITE_APP_TITLE="VRAM Magic"
VITE_APP_DESCRIPTION="GPU memory calculator for LLM deployments"
VITE_APP_KEYWORDS="GPU,VRAM,LLM,memory,calculator,machine learning"

# =============================================================================
# API Configuration
# =============================================================================

VITE_API_BASE_URL=https://api.vram-magic.com/api
VITE_API_TIMEOUT=30000
VITE_MODELS_BASE_URL=/models
VITE_MODELS_CACHE_TTL=3600000

# =============================================================================
# Feature Flags - Production
# =============================================================================

VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_ACCESSIBILITY=true
VITE_FEATURE_EXPORT=true
VITE_FEATURE_ADVANCED_CHARTS=true
VITE_FEATURE_MODEL_COMPARISON=true
VITE_FEATURE_CUSTOM_MODELS=false

# Disable development features
VITE_FEATURE_DEBUG_MODE=false
VITE_FEATURE_PERFORMANCE_MONITORING=true

# =============================================================================
# Analytics and Monitoring - Production
# =============================================================================

# Enable analytics in production
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SENTRY_ENVIRONMENT=production
VITE_PERFORMANCE_MONITORING=true

# =============================================================================
# UI Configuration - Production
# =============================================================================

VITE_THEME_PRIMARY_COLOR=#1976d2
VITE_THEME_SECONDARY_COLOR=#f57c00
VITE_THEME_DEFAULT_MODE=light
VITE_CHART_ANIMATION_DURATION=200
VITE_CHART_RESPONSIVE=true

# =============================================================================
# Build Configuration - Production
# =============================================================================

VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true
VITE_BUNDLE_SIZE_LIMIT=1024
VITE_CHUNK_SIZE_LIMIT=500

# =============================================================================
# Security Configuration - Production
# =============================================================================

VITE_CSP_STRICT_MODE=true
VITE_FORCE_HTTPS=true

# =============================================================================
# Docker Configuration - Production
# =============================================================================

PORT=80
DOMAIN=vram-magic.com

# =============================================================================
# Testing Configuration - Production
# =============================================================================

VITE_TEST_TIMEOUT=30000
VITE_TEST_COVERAGE_THRESHOLD=80
VITE_USE_MOCK_DATA=false
