# VRAM Magic - Development Environment Configuration
# Developer-friendly settings with debugging enabled

# =============================================================================
# Application Configuration
# =============================================================================

VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_APP_TITLE="VRAM Magic (Dev)"
VITE_APP_DESCRIPTION="GPU memory calculator for LLM deployments - Development Build"
VITE_APP_KEYWORDS="GPU,VRAM,LLM,memory,calculator,machine learning"

# =============================================================================
# API Configuration
# =============================================================================

VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000
VITE_MODELS_BASE_URL=/models
VITE_MODELS_CACHE_TTL=1800000

# =============================================================================
# Feature Flags - Development
# =============================================================================

VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_ACCESSIBILITY=true
VITE_FEATURE_EXPORT=true
VITE_FEATURE_ADVANCED_CHARTS=true
VITE_FEATURE_MODEL_COMPARISON=true
VITE_FEATURE_CUSTOM_MODELS=true

# Enable development features
VITE_FEATURE_DEBUG_MODE=true
VITE_FEATURE_PERFORMANCE_MONITORING=true

# =============================================================================
# Analytics and Monitoring - Development
# =============================================================================

# Disable analytics in development
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_ENVIRONMENT=development
VITE_PERFORMANCE_MONITORING=true

# =============================================================================
# UI Configuration - Development
# =============================================================================

VITE_THEME_PRIMARY_COLOR=#1976d2
VITE_THEME_SECONDARY_COLOR=#f57c00
VITE_THEME_DEFAULT_MODE=light
VITE_CHART_ANIMATION_DURATION=300
VITE_CHART_RESPONSIVE=true

# =============================================================================
# Build Configuration - Development
# =============================================================================

VITE_BUILD_ANALYZE=true
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=false
VITE_BUNDLE_SIZE_LIMIT=2048
VITE_CHUNK_SIZE_LIMIT=1000

# =============================================================================
# Security Configuration - Development
# =============================================================================

VITE_CSP_STRICT_MODE=false
VITE_FORCE_HTTPS=false

# =============================================================================
# Development Configuration
# =============================================================================

VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost
VITE_DEV_OPEN=true
VITE_DEV_HMR=true
VITE_DEV_OVERLAY=true

# =============================================================================
# Docker Configuration - Development
# =============================================================================

PORT=3000
DOMAIN=localhost

# =============================================================================
# Testing Configuration - Development
# =============================================================================

VITE_TEST_TIMEOUT=30000
VITE_TEST_COVERAGE_THRESHOLD=70
VITE_USE_MOCK_DATA=true
VITE_MOCK_API_DELAY=500
